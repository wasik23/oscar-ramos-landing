{
  "name": "oscar-ramos-landing",
  "version": "1.0.0",
  "description": "Oscar Ramos custom WEEX registration landing page built with raw HTML, JavaScript, and Less.",
  "private": true,
  "scripts": {
    "build:css": "lessc src/less/main.less dist/css/main.css",
    "watch:css": "lessc --watch src/less/main.less dist/css/main.css",
    "serve": "live-server src --port=3000 --watch=src,dist",
    "dev": "concurrently \"npm:watch:css\" \"npm:serve\""
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "concurrently": "^9.2.4",
    "less": "^4.8.0",
    "live-server": "^1.2.2"
  }
}
